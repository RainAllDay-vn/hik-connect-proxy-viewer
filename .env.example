# Copy thành .env rồi điền. KHÔNG commit file .env.

# --- Đầu ghi Hikvision (trường cấp) ---
# hostname DDNS hoặc IP; cổng SDK (mặc định 8000, trường có thể map sang cổng khác); user/pass đầu ghi
HIK_DOMAIN=recorder.example.net
HIK_SDK_PORT=8000
HIK_USER=user-truong-cap
HIK_PASS=mat-khau-dau-ghi
# 1 = luồng phụ (nhẹ, độ phân giải thấp), 0 = luồng chính
HIK_SUB=0

# --- Web ---
# Mật khẩu gia đình nhập ở màn login
CAM_PASSWORD=change-me
# Khoá ký cookie phiên, chuỗi ngẫu nhiên dài. Tạo: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# --- Time-lapse gửi Telegram (tuỳ chọn) ---
# 1 = bật. Trong khung giờ, mỗi TIMELAPSE_INTERVAL_MINUTES chụp một khung mỗi cam, TIMELAPSE_SEND_AT ghép video gửi Telegram rồi xoá.
TIMELAPSE_ENABLED=0
TIMELAPSE_TZ=Asia/Ho_Chi_Minh
TIMELAPSE_DAYS=1,2,3,4,5
TIMELAPSE_START=08:00
TIMELAPSE_END=17:00
TIMELAPSE_INTERVAL_MINUTES=5
TIMELAPSE_SEND_AT=17:10
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Ghi hình liên tục (tuỳ chọn) ---
# 1 = bật. Ghi MP4 (-c copy, CPU ~0) vào RECORD_DIR/ch<N>, chỉ trong khung giờ RECORD_START..RECORD_END.
# 1080p tốn ~1.5-2.5 GB/giờ/kênh — cân nhắc dung lượng VPS (RECORD_KEEP_DAYS xoá file cũ).
RECORD_ENABLED=0
# Rỗng = ghi mọi kênh discover tìm được; hoặc liệt kê: 42 / 42,33
RECORD_CHANNELS=
RECORD_START=06:00
RECORD_END=20:00
RECORD_TZ=Asia/Ho_Chi_Minh
RECORD_SEGMENT_SECONDS=600
RECORD_KEEP_DAYS=7
# Thư mục trên máy host (bind vào /records trong container)
RECORD_DIR=/hik-connect/records

# --- Caddy ---
# Local: ":80". Trên server có domain trỏ về: "cam.ten-mien.vn" (Caddy tự lấy HTTPS, cần mở 80 và 443)
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443
